# FINSMART - Hostinger Apache Configuration

# 1. Enable UTF-8 encoding
AddDefaultCharset UTF-8

# 2. MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
</IfModule>

# 3. Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# 4. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/json "access plus 1 week"
  ExpiresByType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "(app\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Protection des fichiers sensibles & désactivation de l'exploration
Options -Indexes

<FilesMatch "(\.git|\.env|paydunya\.config|paytech\.config|\.sql|\.log|package\.json|\.sh)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# 7. Redirection forcée vers HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 8. Réécriture des routes API PayDunya et PayTech (Hostinger)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/paydunya/request-payment$ api/paydunya/request-payment.php [L,QSA]
  RewriteRule ^api/paydunya/status$ api/paydunya/status.php [L,QSA]
  RewriteRule ^api/paydunya/ipn$ api/paydunya/ipn.php [L,QSA]
  RewriteRule ^api/paydunya/confirm$ api/paydunya/confirm.php [L,QSA]

  RewriteRule ^api/paytech/request-payment$ api/paytech/request-payment.php [L,QSA]
  RewriteRule ^api/paytech/status$ api/paytech/status.php [L,QSA]
  RewriteRule ^api/paytech/ipn$ api/paytech/ipn.php [L,QSA]
</IfModule>
